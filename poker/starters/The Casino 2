# --- Visual Utilities ---
def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def print_header(title):
    print("=" * 60)
    print(f"{title.center(60)}")
    print("=" * 60)

# --- Class Definitions ---

class Card:
    def __init__(self, suit, rank):
        self.suit = suit
        self.rank = rank
        self.value = VALUES[rank]

    def __str__(self):
        return f"{self.rank}{self.suit}"

    def display_lines(self):
        r = self.rank.ljust(2)
        return [
            "┌─────────┐",
            f"│ {r}      │",
            f"│    {self.suit}    │",
            f"│      {r} │",
            "└─────────┘"
        ]

class Deck:
    def __init__(self):
        self.cards = [Card(s, r) for s in SUITS for r in RANKS]
        self.shuffle()

    def shuffle(self):
        random.shuffle(self.cards)

    def deal(self):
        if not self.cards:
            return None
        return self.cards.pop()

class Player:
    def __init__(self, name="Player", money=1000):
        self.name = name
        self.money = money
        self.loan_debt = 0
        self.hand = []
        self.unlocked_achievements = set() 

    def print_status(self):
        print(f"💰 Wallet: ${self.money} | 🏦 Debt: ${self.loan_debt}")
        print(f"🏆 Achievements: {len(self.unlocked_achievements)}/{len(ACHIEVEMENTS_DB)}")

    def unlock_achievement(self, key):
        """Checks and unlocks an achievement if not already owned."""
        if key in ACHIEVEMENTS_DB and key not in self.unlocked_achievements:
            self.unlocked_achievements.add(key)
            data = ACHIEVEMENTS_DB[key]
            print("\n" + "*" * 50)
            print(f"🏆 ACHIEVEMENT UNLOCKED: {data['title']} 🏆")
            print(f"   {data['desc']}")
            print("*" * 50 + "\n")
            time.sleep(2)

    def check_passive_achievements(self):
        """Checks achievements based on stats (money/debt)."""
        if self.money >= 2500:
            self.unlock_achievement("high_roller")
        if self.money >= 5000:
            self.unlock_achievement("whale") # NEW: The Whale
        if self.money == 0:
            self.unlock_achievement("broke_status") # NEW: Rock Bottom
        if self.loan_debt > 2000:
            self.unlock_achievement("debt_trap")

    def take_loan(self, amount):
        if self.loan_debt > 0:
            self.unlock_achievement("loan_addict") # NEW: Digging Deeper
            
        self.money += amount
        self.loan_debt += amount
        print(f"\n[BANK] You borrowed ${amount}.")
        self.check_passive_achievements()

    def repay_loan(self, amount):
        if amount > self.money:
            print("[BANK] You don't have enough cash!")
        elif amount > self.loan_debt:
            actual_pay = self.loan_debt
            self.money -= actual_pay
            self.loan_debt = 0
            print(f"[BANK] Debt fully paid! Returned ${actual_pay}.")
            self.unlock_achievement("debt_free")
        else:
            self.money -= amount
            self.loan_debt -= amount
            print(f"[BANK] Paid ${amount}. Remaining debt: ${self.loan_debt}")
            if self.loan_debt == 0:
                self.unlock_achievement("debt_free")
        self.check_passive_achievements()

def show_hands(player_hand, dealer_hand, hide_dealer_card=False):
    # Prepare Dealer Hand
    dealer_lines = [""] * 5
    if not dealer_hand:
        visible_cards = []
    elif hide_dealer_card:
        card_back = [
            "┌─────────┐", 
            "│░░░░░░░░░│", 
            "│░░░???░░░│", 
            "│░░░░░░░░░│", 
            "└─────────┘"
        ]
        visible_cards = [card_back] + [c.display_lines() for c in dealer_hand[1:]]
    else:
        visible_cards = [c.display_lines() for c in dealer_hand]

    if visible_cards:
        print("\n--- DEALER'S HAND ---")
        for i in range(5):
            line_str = " ".join([card[i] for card in visible_cards])
            print(line_str)

    # Prepare Player Hand
    print(f"\n--- YOUR HAND ---")
    player_card_lines = [c.display_lines() for c in player_hand]
    for i in range(5):
        line_str = " ".join([card[i] for card in player_card_lines])
        print(line_str)
    print("")

# --- Game Logic: Blackjack ---

def calculate_bj_score(hand):
    score = 0
    aces = 0
    for card in hand:
        score += BJ_VALUES[card.rank]
        if card.rank == 'A':
            aces += 1
     
    while score > 21 and aces:
        score -= 10
        aces -= 1
    return score

def play_blackjack(player):
    deck = Deck()
    clear_screen()
    print_header("BLACKJACK")
    
    while True:
        try:
            player.print_status()
            bet = int(input(f"Place your bet (Max ${player.money}): "))
            if 0 < bet <= player.money:
                break
            print("Invalid bet amount.")
        except ValueError:
            print("Please enter a number.")
            
    # NEW: Bet size achievements
    if bet < 10: player.unlock_achievement("tiny_bet")
    if bet >= 500: player.unlock_achievement("big_spender")

    player_hand = [deck.deal(), deck.deal()]
    dealer_hand = [deck.deal(), deck.deal()]
    game_over = False

    while not game_over:
        clear_screen()
        print_header("BLACKJACK TABLE")
        show_hands(player_hand, dealer_hand, hide_dealer_card=True)
        
        p_score = calculate_bj_score(player_hand)
        print(f"Your Score: {p_score}")
        
        # NEW: Five Card Charlie Check
        if len(player_hand) >= 5 and p_score <= 21:
            player.unlock_achievement("five_card")
        
        if p_score == 21:
            print("Blackjack! 21!")
            player.unlock_achievement("blackjack")
            break
        elif p_score > 21:
            print("Bust! You went over 21.")
            player.unlock_achievement("bj_bust") # NEW: Bust achievement
            player.money -= bet
            input("\nPress Enter to continue...")
            player.check_passive_achievements() # Check broke status
            return

        choice = input("(H)it or (S)tand? ").lower()
        if choice == 'h':
            player_hand.append(deck.deal())
        elif choice == 's':
            break

    # Dealer Turn
    clear_screen()
    print_header("BLACKJACK SHOWDOWN")
    show_hands(player_hand, dealer_hand, hide_dealer_card=False)
    
    p_score = calculate_bj_score(player_hand)
    d_score = calculate_bj_score(dealer_hand)

    while d_score < 17:
        print("Dealer hits...")
        time.sleep(1)
        dealer_hand.append(deck.deal())
        clear_screen()
        print_header("BLACKJACK SHOWDOWN")
        show_hands(player_hand, dealer_hand, hide_dealer_card=False)
        d_score = calculate_bj_score(dealer_hand)
    
    print(f"Your Score: {p_score} | Dealer Score: {d_score}")
    
    if d_score > 21:
        print("Dealer Busted! You Win!")
        player.money += bet
        player.unlock_achievement("first_win")
    elif d_score > p_score:
        print("Dealer Wins.")
        player.money -= bet
    elif d_score < p_score:
        print("You Win!")
        player.money += bet
        player.unlock_achievement("first_win")
    else:
        print("Push (Tie). Money returned.")
        player.unlock_achievement("blackjack_push") # NEW: Tie achievement

    player.check_passive_achievements()
    input("\nPress Enter to return to menu...")

# --- Game Logic: 5-Card Draw Poker ---

def evaluate_poker_hand(hand):
    ranks = sorted([c.value for c in hand])
    suits = [c.suit for c in hand]
    count = Counter(ranks)
    counts = sorted(count.items(), key=lambda x: (-x[1], -x[0]))
    
    is_flush = len(set(suits)) == 1
    is_straight = (ranks[-1] - ranks[0] == 4) and (len(set(ranks)) == 5)
    if not is_straight and set(ranks) == {14, 2, 3, 4, 5}:
        is_straight = True
        ranks = [1, 2, 3, 4, 5]

    if is_straight and is_flush: return (9, "Straight Flush", ranks)
    if counts[0][1] == 4: return (8, "Four of a Kind", counts)
    if counts[0][1] == 3 and counts[1][1] == 2: return (7, "Full House", counts)
    if is_flush: return (6, "Flush", ranks)
    if is_straight: return (5, "Straight", ranks)
    if counts[0][1] == 3: return (4, "Three of a Kind", counts)
    if counts[0][1] == 2 and counts[1][1] == 2: return (3, "Two Pair", counts)
    if counts[0][1] == 2: return (2, "One Pair", counts)
    return (1, "High Card", ranks)

def play_poker(player):
    deck = Deck()
    clear_screen()
    print_header("5-CARD DRAW POKER")

    while True:
        try:
            player.print_status()
            bet = int(input(f"Place your ante (Max ${player.money}): "))
            if 0 < bet <= player.money:
                break
            print("Invalid bet amount.")
        except ValueError:
            print("Please enter a number.")

    # NEW: Bet size achievements
    if bet < 10: player.unlock_achievement("tiny_bet")
    if bet >= 500: player.unlock_achievement("big_spender")

    player_hand = [deck.deal() for _ in range(5)]
    dealer_hand = [deck.deal() for _ in range(5)]

    # Draw Phase
    clear_screen()
    print_header("POKER - DRAW PHASE")
    show_hands(player_hand, [], hide_dealer_card=False)
    
    print("Which cards to discard? (e.g., '1 3 5'). Press Enter to keep all.")
    choice = input("Indices (1-5): ")
    
    if choice.strip():
        try:
            indices = [int(i)-1 for i in choice.split()]
            # NEW: Discard all cards achievement
            if len(indices) == 5:
                player.unlock_achievement("total_swap")

            indices.sort(reverse=True)
            for idx in indices:
                if 0 <= idx < 5:
                    player_hand.pop(idx)
            while len(player_hand) < 5:
                player_hand.append(deck.deal())
        except ValueError:
            print("Invalid input, keeping hand.")

    # Showdown
    clear_screen()
    print_header("POKER - SHOWDOWN")
    show_hands(player_hand, dealer_hand, hide_dealer_card=False)

    p_score, p_desc, p_tie = evaluate_poker_hand(player_hand)
    d_score, d_desc, d_tie = evaluate_poker_hand(dealer_hand)

    print(f"You have: {p_desc}")
    print(f"Dealer has: {d_desc}")
    print("-" * 30)

    # NEW & EXISTING: Poker Hand Achievements
    if p_score >= 4:
         player.unlock_achievement("poker_star")
    if p_score >= 6: 
        player.unlock_achievement("poker_flush") # NEW: Flush or better
    if p_score == 7:
        player.unlock_achievement("poker_fullhouse") # NEW: Full House

    if p_score > d_score:
        print(f"You Win ${bet}!")
        player.money += bet
        player.unlock_achievement("first_win")
        # NEW: Win with High Card (Score 1)
        if p_score == 1:
            player.unlock_achievement("bluff_master")
    elif d_score > p_score:
        print("Dealer Wins.")
        player.money -= bet
    else:
        if p_tie > d_tie:
            print(f"You Win ${bet} (Kicker)!")
            player.money += bet
            player.unlock_achievement("first_win")
            # NEW: Win with High Card via kicker
            if p_score == 1:
                player.unlock_achievement("bluff_master")
        elif d_tie > p_tie:
            print("Dealer Wins (Kicker).")
            player.money -= bet
        else:
            print("It's a complete tie.")

    player.check_passive_achievements()
    input("\nPress Enter to continue...")

