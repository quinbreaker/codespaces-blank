def view_achievements(player):
    clear_screen()
    print_header("🏆 ACHIEVEMENTS 🏆")
    
    for key, data in ACHIEVEMENTS_DB.items():
        status = "✅ UNLOCKED" if key in player.unlocked_achievements else "🔒 LOCKED"
        print(f"{status} - {data['title']}")
        print(f"   {data['desc']}")
        print("-" * 30)
        
    print(f"\nTotal: {len(player.unlocked_achievements)}/{len(ACHIEVEMENTS_DB)}")
    input("\nPress Enter to return...")

def loan_menu(player):
    while True:
        clear_screen()
        print_header("THE LOAN SHARK")
        player.print_status()
        print("\n1. Borrow $500")
        print("2. Borrow $1000")
        print("3. Pay back $500")
        print("4. Pay back ALL debt")
        print("5. Exit Bank")
        
        choice = input("\nSelect Option: ")
        
        if choice == '1': player.take_loan(500)
        elif choice == '2': player.take_loan(1000)
        elif choice == '3': player.repay_loan(500)
        elif choice == '4': player.repay_loan(player.loan_debt)
        elif choice == '5': break
        
        time.sleep(1)

def main():
    player = Player()
    
    while True:
        clear_screen()
        print_header("PYTHON CASINO SIMULATOR")
        player.print_status()
        print("\n1. Play Blackjack")
        print("2. Play Poker (5-Card Draw)")
        print("3. Read Rules")
        print("4. Visit Loan Shark")
        print("5. View Achievements") 
        print("6. Quit")
        
        choice = input("\nSelect Option: ")
        
        if choice == '1':
            play_blackjack(player)
        elif choice == '2':
            play_poker(player)
        elif choice == '3':
            show_rules()
        elif choice == '4':
            loan_menu(player)
        elif choice == '5':
            view_achievements(player)
        elif choice == '6':
            print("Thanks for playing! Goodbye.")
            break

if __name__ == "__main__":
    main()