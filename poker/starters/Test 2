    def take_loan(self, amount):
        self.money += amount
        self.loan_debt += amount
        self.stats['loan_visits'] += 1
        print(f"\n[BANK] You borrowed ${amount}.")
        self.unlock_achievement("borrower")
        self.check_stats_achievements()

    def repay_loan(self, amount):
        self.stats['loan_visits'] += 1
        if amount > self.money:
            print("[BANK] You don't have enough cash!")
        elif amount > self.loan_debt:
            actual_pay = self.loan_debt
            self.money -= actual_pay
            self.loan_debt = 0
            self.stats['total_repaid'] += actual_pay
            print(f"[BANK] Debt fully paid! Returned ${actual_pay}.")
            self.unlock_achievement("debt_free")
        else:
            self.money -= amount
            self.loan_debt -= amount
            self.stats['total_repaid'] += amount
            print(f"[BANK] Paid ${amount}. Remaining debt: ${self.loan_debt}")
            if self.loan_debt == 0:
                self.unlock_achievement("debt_free")
        self.check_stats_achievements()

def show_hands(player_hand, dealer_hand, hide_dealer_card=False):
    # Prepare Dealer Hand
    dealer_lines = [""] * 5
    if hide_dealer_card:
        card_back = [
            "┌─────────┐", 
            "│░░░░░░░░░│", 
            "│░░░???░░░│", 
            "│░░░░░░░░░│", 
            "└─────────┘"
        ]
        visible_cards = [card_back] + [c.display_lines() for c in dealer_hand[1:]]
    else:
        visible_cards = [c.display_lines() for c in dealer_hand]

    print("\n--- DEALER'S HAND ---")
    for i in range(5):
        line_str = " ".join([card[i] for card in visible_cards])
        print(line_str)

    # Prepare Player Hand
    print(f"\n--- YOUR HAND ---")
    player_card_lines = [c.display_lines() for c in player_hand]
    for i in range(5):
        line_str = " ".join([card[i] for card in player_card_lines])
        print(line_str)
    print("")

# --- Game Logic: Blackjack ---

def calculate_bj_score(hand):
    score = 0
    aces = 0
    for card in hand:
        score += BJ_VALUES[card.rank]
        if card.rank == 'A':
            aces += 1
    
    while score > 21 and aces:
        score -= 10
        aces -= 1
    return score

def check_hand_achievements(player, hand):
    """Checks for achievements based on card contents."""
    suits = [c.suit for c in hand]
    ranks = [c.rank for c in hand]
    
    # Check for specific cards
    for c in hand:
        if c.rank == '7' and c.suit == '♥':
            player.unlock_achievement("lucky_7")
            
    # Check counts
    if ranks.count('A') >= 3: player.unlock_achievement("ace_hole")
    if suits.count('♠') >= 4: player.unlock_achievement("suit_spade")
    if suits.count('♥') >= 4: player.unlock_achievement("suit_heart")

def play_blackjack(player):
    deck = Deck()
    clear_screen()
    print_header("BLACKJACK")
    
    while True:
        try:
            player.print_status()
            bet_input = input(f"Place your bet (Max ${player.money}): ")
            if not bet_input.strip(): continue
            bet = int(bet_input)
            
            if 0 < bet <= player.money:
                break
            print("Invalid bet amount.")
        except ValueError:
            print("Please enter a number.")

    # Betting Achievements
    if bet == 1: player.unlock_achievement("penny_pincher")
    if bet == player.money: player.unlock_achievement("all_in")
    if bet >= 1000: player.unlock_achievement("big_spender")

    player_hand = [deck.deal(), deck.deal()]
    dealer_hand = [deck.deal(), deck.deal()]
    game_over = False
    hit_count = 0
    stood_value = 0 # To track for 'cautious' achievement

    while not game_over:
        clear_screen()
        print_header("BLACKJACK TABLE")
        show_hands(player_hand, dealer_hand, hide_dealer_card=True)
        
        p_score = calculate_bj_score(player_hand)
        print(f"Your Score: {p_score}")
        
        # 5-Card Charlie Check
        if len(player_hand) >= 5 and p_score <= 21:
            player.unlock_achievement("charlie")

        if p_score == 21:
            print("Blackjack! 21!")
            if len(player_hand) == 2:
                player.unlock_achievement("bj_native")
                player.stats['blackjack_count'] += 1
                player.stats['consecutive_bj'] += 1 # Increment for God Mode
            else:
                player.stats['consecutive_bj'] = 0 # Reset if 21 but not natural
            player.unlock_achievement("close_call")
            break
        elif p_score > 21:
            print("Bust! You went over 21.")
            player.money -= bet
            player.stats['bust_count'] += 1
            if bet >= 1000: player.unlock_achievement("big_loss")
            player.update_streak(-1, 'bj')
            player.stats['games_played'] += 1
            player.check_stats_achievements()
            input("\nPress Enter to continue...")
            return

        choice = input("(H)it or (S)tand? ").lower()
        if choice == 'h':
            player_hand.append(deck.deal())
            hit_count += 1
        elif choice == 's':
            stood_value = p_score
            break
    
    if hit_count >= 3 and calculate_bj_score(player_hand) <= 21:
        player.unlock_achievement("hit_me")

    # Dealer Turn
    clear_screen()
    print_header("BLACKJACK SHOWDOWN")
    show_hands(player_hand, dealer_hand, hide_dealer_card=False)
    
    p_score = calculate_bj_score(player_hand)
    d_score = calculate_bj_score(dealer_hand)

    while d_score < 17:
        print("Dealer hits...")
        time.sleep(1)
        dealer_hand.append(deck.deal())
        clear_screen()
        print_header("BLACKJACK SHOWDOWN")
        show_hands(player_hand, dealer_hand, hide_dealer_card=False)
        d_score = calculate_bj_score(dealer_hand)
    
    print(f"Your Score: {p_score} | Dealer Score: {d_score}")
    
    win = False
    if d_score > 21:
        print("Dealer Busted! You Win!")
        win = True
    elif d_score > p_score:
        print("Dealer Wins.")
        player.money -= bet
        player.stats['consecutive_bj'] = 0
        if bet >= 1000: player.unlock_achievement("big_loss")
        player.update_streak(-1, 'bj')
    elif d_score < p_score:
        print("You Win!")
        win = True
    else:
        print("Push (Tie). Money returned.")
        player.update_streak(0, 'bj')

    if win:
        if player.money == bet: player.unlock_achievement("dollar_dream") # Won with only bet amount left
        if player.loan_debt > 10000: player.unlock_achievement("living_edge")
        
        player.money += bet
        player.stats['cumulative_earnings'] += bet
        player.update_streak(1, 'bj')
        
        # Contextual Win achievements
        if bet >= 10000: player.unlock_achievement("high_stakes_hero")
        if p_score < 17: player.unlock_achievement("low_ball")
        if p_score == 21: player.unlock_achievement("close_call")
        if p_score == 20: player.unlock_achievement("solid_20")
        if stood_value > 0 and stood_value <= 14: player.unlock_achievement("cautious")
        if (p_score - d_score) == 1: player.unlock_achievement("sniper")
        if (p_score - d_score) >= 10: player.unlock_achievement("overkill")
    
    if p_score != 21 or len(player_hand) > 2:
        # If it wasn't a natural blackjack, reset the counter
        player.stats['consecutive_bj'] = 0

    # Check hand contents for rare cards
    check_hand_achievements(player, player_hand)

    player.stats['games_played'] += 1
    player.check_stats_achievements()
    input("\nPress Enter to return to menu...")

# --- Game Logic: 5-Card Draw Poker ---

def evaluate_poker_hand(hand):
    """
    Returns (score, description, tie_breaker_data)
    Scores: 1=High, 2=Pair, 3=2Pair, 4=3Kind, 5=Str, 6=Flush, 7=FullH, 8=4Kind, 9=StrFlush
    """
    ranks = sorted([c.value for c in hand])
    suits = [c.suit for c in hand]
    count = Counter(ranks)
    counts = sorted(count.items(), key=lambda x: (-x[1], -x[0]))
    
    is_flush = len(set(suits)) == 1
    is_straight = (ranks[-1] - ranks[0] == 4) and (len(set(ranks)) == 5)
    
    # Ace low straight (A, 2, 3, 4, 5) -> ranks are 14, 2, 3, 4, 5
    if not is_straight and set(ranks) == {14, 2, 3, 4, 5}:
        is_straight = True
        ranks = [1, 2, 3, 4, 5] # Treat Ace as 1

    if is_straight and is_flush: 
        if ranks[-1] == 14: return (10, "Royal Flush", ranks)
        return (9, "Straight Flush", ranks)
    if counts[0][1] == 4: return (8, "Four of a Kind", counts)
    if counts[0][1] == 3 and counts[1][1] == 2: return (7, "Full House", counts)
    if is_flush: return (6, "Flush", ranks)
    if is_straight: return (5, "Straight", ranks)
    if counts[0][1] == 3: return (4, "Three of a Kind", counts)
    if counts[0][1] == 2 and counts[1][1] == 2: return (3, "Two Pair", counts)
    if counts[0][1] == 2: return (2, "One Pair", counts)
    return (1, "High Card", ranks)

def play_poker(player):
    deck = Deck()
    clear_screen()
    print_header("5-CARD DRAW POKER")

    while True:
        try:
            player.print_status()
            bet_input = input(f"Place your ante (Max ${player.money}): ")
            if not bet_input.strip(): continue
            bet = int(bet_input)
            if 0 < bet <= player.money:
                break
            print("Invalid bet amount.")
        except ValueError:
            print("Please enter a number.")
            
    # Betting Achievements
    if bet == 1: player.unlock_achievement("penny_pincher")
    if bet == player.money: player.unlock_achievement("all_in")
    if bet >= 1000: player.unlock_achievement("big_spender")

    player_hand = [deck.deal() for _ in range(5)]
    dealer_hand = [deck.deal() for _ in range(5)]

    # Draw Phase
    clear_screen()
    print_header("POKER - DRAW PHASE")
    show_hands(player_hand, [], hide_dealer_card=False)
    
    print("Which cards to discard? (e.g., '1 3 5'). Press Enter to keep all.")
    choice = input("Indices (1-5): ")
    
    discard_count = 0
    if choice.strip():
        try:
            indices = [int(i)-1 for i in choice.split()]
            indices.sort(reverse=True)
            for idx in indices:
                if 0 <= idx < 5:
                    player_hand.pop(idx)
                    discard_count += 1
            while len(player_hand) < 5:
                player_hand.append(deck.deal())
        except ValueError:
            print("Invalid input, keeping hand.")
            
    if discard_count == 5:
        player.unlock_achievement("empty_hand")

    # Showdown
    clear_screen()
    print_header("POKER - SHOWDOWN")
    show_hands(player_hand, dealer_hand, hide_dealer_card=False)

    p_score, p_desc, p_tie = evaluate_poker_hand(player_hand)
    d_score, d_desc, d_tie = evaluate_poker_hand(dealer_hand)

    print(f"You have: {p_desc}")
    print(f"Dealer has: {d_desc}")
    print("-" * 30)

    # --- Poker Hand Achievements ---
    if p_score == 2: player.unlock_achievement("poker_pair")
    if p_score == 3: player.unlock_achievement("poker_2pair")
    if p_score == 4: player.unlock_achievement("poker_trips")
    if p_score == 5: player.unlock_achievement("poker_straight")
    if p_score == 6: player.unlock_achievement("poker_flush")
    if p_score == 7: player.unlock_achievement("poker_full")
    if p_score == 8: player.unlock_achievement("poker_quads")
    if p_score == 9: player.unlock_achievement("poker_sf")
    if p_score == 10: player.unlock_achievement("poker_royal")

    # Win/Loss Logic
    win = False
    if p_score > d_score:
        print(f"You Win ${bet}!")
        win = True
    elif d_score > p_score:
        print("Dealer Wins.")
        player.money -= bet
        if bet >= 1000: player.unlock_achievement("big_loss")
        player.update_streak(-1, 'poker')
        if p_score == 1: player.unlock_achievement("fold_master")
    else:
        # Tie breakers
        if p_tie > d_tie:
            print(f"You Win ${bet} (Kicker)!")
            win = True
        elif d_tie > p_tie:
            print("Dealer Wins (Kicker).")
            player.money -= bet
            if bet >= 1000: player.unlock_achievement("big_loss")
            player.update_streak(-1, 'poker')
        else:
            print("It's a complete tie.")
            player.update_streak(0, 'poker')

    if win:
        if player.money == bet: player.unlock_achievement("dollar_dream")
        if player.loan_debt > 10000: player.unlock_achievement("living_edge")
        
        player.money += bet
        player.stats['cumulative_earnings'] += bet
        player.update_streak(1, 'poker')
        
        if bet >= 10000: player.unlock_achievement("high_stakes_hero")
        if p_score == 1: player.unlock_achievement("bluffer") # Won with high card only

    # Check hand contents for rare cards
    check_hand_achievements(player, player_hand)
    
    player.stats['games_played'] += 1
    player.check_stats_achievements()
    input("\nPress Enter to continue...")

