            print(f"   {data['desc']}")
            print("★" * 50 + "\n")
            time.sleep(1.5)

    def update_streak(self, result, game_type="generic"):
        """ result: 1 (win), -1 (loss), 0 (tie) """
        s = self.stats
        
        if result == 1:
            # General Streak
            if s['current_streak'] < 0: s['current_streak'] = 0
            s['current_streak'] += 1
            s['wins'] += 1
            if s['current_streak'] > s['max_win_streak']:
                s['max_win_streak'] = s['current_streak']
            
            # Type specific streaks
            s['consecutive_push'] = 0
            if game_type == 'poker':
                s['consecutive_poker'] += 1
            else:
                s['consecutive_poker'] = 0

            # Beginner Luck
            if s['games_played'] < 3:
                s['start_wins'] += 1
                
        elif result == -1:
            if s['current_streak'] > 0: s['current_streak'] = 0
            s['current_streak'] -= 1
            s['losses'] += 1
            
            if s['current_streak'] < s['max_loss_streak']:
                s['max_loss_streak'] = s['current_streak']
            
            # Reset specific
            s['consecutive_bj'] = 0
            s['consecutive_push'] = 0
            s['consecutive_poker'] = 0
            s['start_wins'] = 0
                
        else: # Tie
            s['pushes'] += 1
            s['consecutive_push'] += 1
            # Reset win specific streaks on tie? Usually yes for "consecutive wins"
            s['consecutive_bj'] = 0
            s['consecutive_poker'] = 0

