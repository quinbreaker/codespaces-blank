const getUserChoice = userInput => {
  // lowercase
  userInput = userInput.toLowerCase();
  if (userInput === 'rock' || userInput === 'paper') {
    return userInput;
  } else if (userInput === 'scissors') {
    return userInput;
  } else {
    return 'Input Error!';
  }
};

